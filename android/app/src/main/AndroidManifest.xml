<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xingnang.packing">

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".Widget4SoftProvider"
            android:exported="true"
            android:label="@string/widget_4_soft_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4_soft_info" />
        </receiver>

        <receiver
            android:name=".Widget4FrostProvider"
            android:exported="true"
            android:label="@string/widget_4_frost_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4_frost_info" />
        </receiver>

        <receiver
            android:name=".Widget5SoftProvider"
            android:exported="true"
            android:label="@string/widget_5_soft_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_5_soft_info" />
        </receiver>

        <receiver
            android:name=".Widget5FrostProvider"
            android:exported="true"
            android:label="@string/widget_5_frost_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_5_frost_info" />
        </receiver>
    </application>

</manifest>
